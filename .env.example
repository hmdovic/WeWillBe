# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# EmailJS (emailjs.com) — all three are required for the pre-order form to
# send directly instead of falling back to a mailto: link.
# Get these from your EmailJS dashboard: Account > API Keys (public key),
# Email Services (service ID), Email Templates (template ID). Build a
# template with fields matching the form: firstName, lastName, email,
# phone, street, houseNumber, postalCode, city, country, product, size,
# quantity, notes.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Google Analytics 4 — optional. Leave blank to keep analytics off
# entirely (no script loads, no cookie banner shows).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
